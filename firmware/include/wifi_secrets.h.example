#ifndef WIFI_SECRETS_H
#define WIFI_SECRETS_H

/**
 * @file wifi_secrets.h
 * @brief Credenciales de la WiFi y servidor del puente ESP8266.
 *
 * ⚠️ **Este fichero NO se sube al repositorio** (está en `.gitignore`): lleva la contraseña de la red
 * en claro. El que sí está versionado es `wifi_secrets.h.example`, que es la plantilla: se copia y se
 * rellenan los tres primeros valores.
 *
 *     cp firmware/include/wifi_secrets.h.example firmware/include/wifi_secrets.h
 *
 * @note Está en `include/` y no en una capa porque **no es código**: es la configuración del banco.
 *       Ningún módulo la lee salvo `hal/esp8266.c`, que es quien levanta el puente.
 */

/** @brief Red a la que se conecta el robot (SSID). */
#define WIFI_SSID       "PON_AQUI_TU_RED"

/** @brief Contraseña de esa red. */
#define WIFI_CLAVE      "PON_AQUI_TU_CLAVE"

/**
 * @brief IP del PC donde escucha el servidor del puente.
 *
 * Tiene que ser una IP **de la misma red** a la que se conecta el robot: si el PC está por cable y el
 * robot por WiFi, los dos tienen que estar en el mismo segmento o no se ven.
 */
#define WIFI_SERVIDOR   "192.168.2.251"

/** @brief Puerto TCP del servidor del puente. */
#define WIFI_PUERTO     3333

#endif /* WIFI_SECRETS_H */
